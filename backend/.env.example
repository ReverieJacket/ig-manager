# Copie para backend/.env e preencha. O .env NUNCA deve ser versionado.

# Porta da API
PORT=3000

# URL do frontend (links de convite). Padrão: http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Origem permitida no CORS (URL do frontend). Vazio = usa FRONTEND_URL.
CORS_ORIGIN=http://localhost:5173

# Segredo que assina as sessões de login (obrigatório, mín. 32 caracteres).
# Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Trocar este valor desconecta todos os usuários.
AUTH_SEGREDO=

# Supabase (Project Settings > API). A service role é secreta: só no backend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Logs: debug | info | warn | error | silent
# (padrão: debug em desenvolvimento, info com NODE_ENV=production)
LOG_LEVEL=
# Grava também em storage/logs/backend.log (JSON). true | false
LOG_EM_ARQUIVO=false

# O cliente pode conectar o próprio perfil em "Meus perfis" (true | false).
# O Chromium abre no computador do BACKEND: deixe true enquanto tudo roda na
# mesma máquina; em servidor (EC2) use false até existir o navegador remoto.
CONEXAO_PELO_CLIENTE=true
