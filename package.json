{
  "name": "ig-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Agendamento e publicação de posts no Instagram (Vue + Express + Playwright + Supabase)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "login:instagram": "npm run login:instagram -w backend --",
    "verificar:conexao": "npm run verificar:conexao -w backend"
  },
  "engines": {
    "node": ">=20"
  }
}
